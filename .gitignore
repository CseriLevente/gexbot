.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets and machine-local config. Never commit a vendor credential.
.env
.env.*
!.env.example
config/local.yaml
secrets/

# Runtime data and artefacts
data/
logs/
*.db
*.sqlite3
exports/
research_output/
# Raw vendor responses captured at runtime. Checked-in fixtures live under
# tests/fixtures/vendor/ and are NOT covered by this rule.
raw_responses/
# The configured capture destination. A real run writes vendor bytes here; a
# test run writes fixture bytes here. Neither belongs in the repository or in a
# release archive, and 573 of the latter reached a build before this line
# existed -- see tests/unit/test_release_integrity.py, which now fails on them.
artifacts/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Release archives are build output, produced by docs/RELEASE.md step 4.
# They must never be tracked: a tracked artefact makes the tree dirty at the
# exact moment the release procedure requires it to be clean.
gex-bot-*.zip
