# Normalise line endings so the repository is byte-identical across platforms.
# This matters more than usual here: the replay test hashes normalised snapshots,
# and fixture files are hashed as part of the raw-response store.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Vendor response fixtures are compared byte-for-byte; never let a checkout
# rewrite their line endings.
tests/fixtures/vendor/** -text

*.png   binary
*.jpg   binary
*.docx  binary
*.zip   binary
